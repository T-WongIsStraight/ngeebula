# Copy to .env.local (dev) or set in your host's build settings (production).

# DEV ONLY. Where `npm run dev` forwards /api requests to.
# Default: http://localhost:8000 (what run.ps1 / run.sh start).
VITE_DEV_API=http://127.0.0.1:8040

# PRODUCTION. Base URL of the hosted FastAPI backend, no trailing slash.
# Leave empty (the default) when the API is served from the same origin as the
# app. On Netlify set it to the public backend URL, e.g.
#   VITE_API_BASE_URL=https://ngeebula-api.onrender.com
VITE_API_BASE_URL=
